# Copy this file to ".env". Only the Telegram token is required. Never share the .env file.

# From @BotFather in Telegram
TELEGRAM_BOT_TOKEN=

# OPTIONAL — from https://console.anthropic.com → API Keys.
# With it: the bot reads screenshots and Claude writes your summary.
# Without it: send Binance export files (CSV/Excel) and the summary is rule-based.
ANTHROPIC_API_KEY=

# Model that reads your screenshots
CLAUDE_MODEL=claude-sonnet-5-5

# Your time zone and when messages arrive
TIMEZONE=Africa/Addis_Ababa
MORNING_TIME=08:00
# Evening nudge if you haven't sent screenshots yet (leave empty to turn off)
EVENING_REMINDER=21:00

# Your trading rules
MAX_HOLD_MIN=10
MAX_LOSSES_PER_COIN=2

# Scanner settings
SCAN_TOP=30
SCAN_MIN_VOL_M=20

# Optional: the https link where you put the webapp folder (see README, step 5)
WEBAPP_URL=https://datradingbot.netlify.app

# Optional: lock the bot to your Telegram chat id. If empty, the first person to send /start becomes the owner.
OWNER_CHAT_ID=
